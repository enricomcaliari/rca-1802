# uROM.mem � Microcodigo do processador RCA CDP1802
# Grupo 4 | Arquitetura e Organizacao de Computadores 2026/1
# Referencia: RCA_1802_microROM.pdf (Pessoa 1/2)
#
# Formato da microinstrucao (32 bits):
#  [31:28] ALU_OP    4: 0=NOP 1=PASS_A 2=PASS_B 3=ADD 4=ADC 5=SM 6=SMB
#                       7=SD 8=SDB 9=OR A=AND B=XOR C=SHR D=SHRC E=SHL F=SHLC
#  [27:25] SRC_A     3: 0=ZERO 1=D 2=MEM 3=RN.L 4=RN.H 5=RX.L 6=RX.H 7=T
#  [24:22] SRC_B     3: 0=ZERO 1=D 2=MEM 3=LIT1 4=N_EXP 5=DF_EXP 6=T
#  [21:18] DST       4: 0=none 1=D 2=MEM 3=RN.L 4=RN.H 5=RP.L 6=RP.H
#                       7=P 8=X 9=T A=IE B=Q C=TMP_H D=TMP_L E=OUT_BUS
#  [17:15] ADDR_SRC  3: 0=none 1=R(P) 2=R(N) 3=R(X) 4=R0 5=RTMP
#  [14:11] REG_SEL   4: 0=none 1=N 2=P 3=X 4=R0 5=R1 6=R2 7=PLA
#  [10]    MEM_RD    1
#  [9]     MEM_WR    1
#  [8]     IR_LOAD   1
#  [7]     REG_INC   1
#  [6]     REG_DEC   1
#  [5]     DF_LOAD   1
#  [4]     Q_LOAD    1
#  [3]     COND_EN   1
#  [2:0]   NEXT_ST   3: 0=FETCH 1=EXECUTE1 2=EXECUTE2
#
# Enderecamento: ?ADDR[8:0] = { STATE[2:0], INSTR_CLASS[5:0] }
#   FETCH    (000): 0x000-0x03F
#   EXECUTE1 (001): 0x040-0x07F
#   EXECUTE2 (010): 0x080-0x0BF
#   Reservado:      0x0C0-0x1FF
#
# INSTR_CLASS gerado pela PLA a partir do opcode completo:
#   0x00=IDL  0x01=LDN  0x02=INC  0x03=DEC  0x04=BR   0x05=LDA  0x06=STR
#   0x07=IRX  0x08=OUT  0x09=IN   0x0A=RET  0x0B=DIS  0x0C=LDXA 0x0D=STXD
#   0x0E=ADC  0x0F=SDB  0x10=SHRC 0x11=SMB  0x12=SAV  0x13=MARK 0x14=REQ
#   0x15=SEQ  0x16=ADCI 0x17=SDBI 0x18=SHLC 0x19=SMBI 0x1A=GLO  0x1B=GHI
#   0x1C=PLO  0x1D=PHI  0x1E=LBSK 0x1F=SEP  0x20=SEX  0x21=LDX  0x22=OR
#   0x23=AND  0x24=XOR  0x25=ADD  0x26=SD   0x27=SHR  0x28=SM   0x29=LDI
#   0x2A=ORI  0x2B=ANI  0x2C=XRI  0x2D=ADI  0x2E=SDI  0x2F=SHL  0x30=SMI

