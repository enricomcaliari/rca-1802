<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="4.0.0" version="1.0">
  This file is intended to be loaded by Logisim-evolution v4.0.0(https://github.com/logisim-evolution/).

  <lib desc="#Wiring" name="0">
    <tool name="Pin">
      <a name="appearance" val="classic"/>
    </tool>
  </lib>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#TTL" name="6"/>
  <lib desc="#TCL" name="7"/>
  <lib desc="#Base" name="8"/>
  <lib desc="#BFH-Praktika" name="9"/>
  <lib desc="#Input/Output-Extra" name="10"/>
  <lib desc="#Soc" name="11"/>
  <main name="controle"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <mappings>
    <tool lib="8" map="Button2" name="Poke Tool"/>
    <tool lib="8" map="Button3" name="Menu Tool"/>
    <tool lib="8" map="Ctrl Button1" name="Menu Tool"/>
  </mappings>
  <toolbar>
    <tool lib="8" name="Poke Tool"/>
    <tool lib="8" name="Edit Tool"/>
    <tool lib="8" name="Wiring Tool"/>
    <tool lib="8" name="Text Tool"/>
    <sep/>
    <tool lib="0" name="Pin"/>
    <tool lib="0" name="Pin">
      <a name="facing" val="west"/>
      <a name="type" val="output"/>
    </tool>
    <sep/>
    <tool lib="1" name="NOT Gate"/>
    <tool lib="1" name="AND Gate"/>
    <tool lib="1" name="OR Gate"/>
    <tool lib="1" name="XOR Gate"/>
    <tool lib="1" name="NAND Gate"/>
    <tool lib="1" name="NOR Gate"/>
    <sep/>
  </toolbar>

  <!--
    controle.circ - Unidade de Controle Microprogramada RCA CDP1802
    Logisim-evolution 4.0.0

    ================================================================
    POSICOES DAS PORTAS - extraidas do codigo-fonte do Logisim v4.0.0
    (Register.java, updatePorts(), APPEAR_EVOLUTION)
    ================================================================

    Register EVOLUTION loc=(X,Y), bounds=(0,0,60,90):
      Q   (OUT) = (X+60, Y+30)
      D   (IN)  = (X+0,  Y+30)
      CK        = (X+0,  Y+70)
      CLR       = (X+30, Y+90)
      EN        = (X+0,  Y+50)   <- nao conectado (escreve sempre)

    Register loc=(400,370):
      Q   = (460, 400)
      D   = (400, 400)
      CK  = (400, 440)
      CLR = (430, 460)
      EN  = (400, 420)  <- nao conectado

    Splitter facing=west, formula v4.0.0:  y_i = loc_y + (i+1)*10
    ================================================================

    ADDR_COMBINER loc=(650,350), facing=west, fanout=2, incoming=9:
      grupo 0 (STATE    3b, bits 6-8): porta em (630, 360)
      grupo 1 (INSTR    6b, bits 0-5): porta em (630, 370)
      tronco (9b): (650,350) -> ROM addr (760,350)

    MW_SPLITTER loc=(1020,350), facing=west, fanout=15, incoming=32:
      grupo  0 (NEXT_STATE  3b, bits  0-2):  (1000, 360)
      grupo  1 (COND_EN     1b, bit   3):    (1000, 370)
      grupo  2 (Q_LOAD      1b, bit   4):    (1000, 380)
      grupo  3 (DF_LOAD     1b, bit   5):    (1000, 390)
      grupo  4 (REG_DEC     1b, bit   6):    (1000, 400)
      grupo  5 (REG_INC     1b, bit   7):    (1000, 410)
      grupo  6 (IR_LOAD     1b, bit   8):    (1000, 420)
      grupo  7 (MEM_WR      1b, bit   9):    (1000, 430)
      grupo  8 (MEM_RD      1b, bit  10):    (1000, 440)
      grupo  9 (REG_SEL_SRC 4b, bits 11-14): (1000, 450)
      grupo 10 (ADDR_SRC    3b, bits 15-17): (1000, 460)
      grupo 11 (DST         4b, bits 18-21): (1000, 470)
      grupo 12 (SRC_B       3b, bits 22-24): (1000, 480)
      grupo 13 (SRC_A       3b, bits 25-27): (1000, 490)
      grupo 14 (ALU_OP      4b, bits 28-31): (1000, 500)
      tronco (32b): (1020,350) <- ROM data (830,350)

    ROM loc=(790,350):
      Addr = (760,350)  <- tronco ADDR_COMBINER
      Data = (830,350)  -> tronco MW_SPLITTER
  -->

  <circuit name="controle">
    <a name="appearance" val="logisim_evolution"/>

    <!-- ============================================================
         PINOS DE ENTRADA
         ============================================================ -->

    <comp lib="0" loc="(100,200)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="6"/>
      <a name="label" val="INSTR_CLASS[5:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(100,440)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="1"/>
      <a name="label" val="CLK"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(100,480)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="1"/>
      <a name="label" val="RESET"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(100,540)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="1"/>
      <a name="label" val="DF"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(100,570)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="1"/>
      <a name="label" val="Q_IN"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(100,600)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="4"/>
      <a name="label" val="EF[3:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(100,630)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="1"/>
      <a name="label" val="D_ZERO"/>
      <a name="facing" val="east"/>
    </comp>

    <!-- ============================================================
         REG_ESTADO - Register 3 bits, EVOLUTION appearance (padrao)
         loc=(400,370), bounds=(400,370)-(460,460)

         Portas (codigo-fonte Register.java v4.0.0, APPEAR_EVOLUTION):
           Q   = loc+(60,30) = (460, 400)
           D   = loc+(0, 30) = (400, 400)
           CK  = loc+(0, 70) = (400, 440)
           CLR = loc+(30,90) = (430, 460)
           EN  = loc+(0, 50) = (400, 420)  (nao conectado) nao conectado
         ============================================================ -->
    <comp lib="4" loc="(400,370)" name="Register">
      <a name="width" val="3"/>
      <a name="label" val="REG_ESTADO"/>
    </comp>

    <!-- ============================================================
         ADDR_COMBINER: ADDR[8:0] = { STATE[2:0], INSTR_CLASS[5:0] }
         Splitter facing=west, loc=(650,350), fanout=2, incoming=9
         v4.0.0: grupo i em y = 350+(i+1)*10
           grupo 0 (bits 6-8 = STATE  3b): y=360 -> (630,360)
           grupo 1 (bits 0-5 = INSTR  6b): y=370 -> (630,370)
         ============================================================ -->
    <comp lib="0" loc="(650,350)" name="Splitter">
      <a name="facing" val="west"/>
      <a name="incoming" val="9"/>
      <a name="fanout" val="2"/>
      <a name="bit0" val="1"/>
      <a name="bit1" val="1"/>
      <a name="bit2" val="1"/>
      <a name="bit3" val="1"/>
      <a name="bit4" val="1"/>
      <a name="bit5" val="1"/>
      <a name="bit6" val="0"/>
      <a name="bit7" val="0"/>
      <a name="bit8" val="0"/>
      <a name="label" val="ADDR_COMBINER"/>
    </comp>

    <!-- ============================================================
         uROM - ROM 512 x 32 bits  (botao direito -> Load -> uROM.mem)
         loc=(790,350): Addr=(760,350)  Data=(830,350)
         ============================================================ -->
    <comp lib="4" loc="(790,350)" name="ROM">
      <a name="addrWidth" val="9"/>
      <a name="dataWidth" val="32"/>
      <a name="label" val="uROM"/>
    </comp>

    <!-- ============================================================
         MW_SPLITTER: decompoe micropalavra 32 bits
         Splitter facing=west, loc=(1020,350), fanout=15, incoming=32
         v4.0.0: grupo i em y = 350+(i+1)*10
           g0  NEXT_STATE  3b (bits  0-2):  (1000,360)
           g1  COND_EN     1b (bit   3):    (1000,370)
           g2  Q_LOAD      1b (bit   4):    (1000,380)
           g3  DF_LOAD     1b (bit   5):    (1000,390)
           g4  REG_DEC     1b (bit   6):    (1000,400)
           g5  REG_INC     1b (bit   7):    (1000,410)
           g6  IR_LOAD     1b (bit   8):    (1000,420)
           g7  MEM_WR      1b (bit   9):    (1000,430)
           g8  MEM_RD      1b (bit  10):    (1000,440)
           g9  REG_SEL_SRC 4b (bits 11-14): (1000,450)
           g10 ADDR_SRC    3b (bits 15-17): (1000,460)
           g11 DST         4b (bits 18-21): (1000,470)
           g12 SRC_B       3b (bits 22-24): (1000,480)
           g13 SRC_A       3b (bits 25-27): (1000,490)
           g14 ALU_OP      4b (bits 28-31): (1000,500)
         ============================================================ -->
    <comp lib="0" loc="(1020,350)" name="Splitter">
      <a name="facing" val="west"/>
      <a name="incoming" val="32"/>
      <a name="fanout" val="15"/>
      <a name="bit0"  val="0"/>
      <a name="bit1"  val="0"/>
      <a name="bit2"  val="0"/>
      <a name="bit3"  val="1"/>
      <a name="bit4"  val="2"/>
      <a name="bit5"  val="3"/>
      <a name="bit6"  val="4"/>
      <a name="bit7"  val="5"/>
      <a name="bit8"  val="6"/>
      <a name="bit9"  val="7"/>
      <a name="bit10" val="8"/>
      <a name="bit11" val="9"/>
      <a name="bit12" val="9"/>
      <a name="bit13" val="9"/>
      <a name="bit14" val="9"/>
      <a name="bit15" val="10"/>
      <a name="bit16" val="10"/>
      <a name="bit17" val="10"/>
      <a name="bit18" val="11"/>
      <a name="bit19" val="11"/>
      <a name="bit20" val="11"/>
      <a name="bit21" val="11"/>
      <a name="bit22" val="12"/>
      <a name="bit23" val="12"/>
      <a name="bit24" val="12"/>
      <a name="bit25" val="13"/>
      <a name="bit26" val="13"/>
      <a name="bit27" val="13"/>
      <a name="bit28" val="14"/>
      <a name="bit29" val="14"/>
      <a name="bit30" val="14"/>
      <a name="bit31" val="14"/>
      <a name="label" val="MW_SPLITTER"/>
    </comp>

    <!-- ============================================================
         PINOS DE SAIDA - alinhados com portas MW_SPLITTER
         x=1200, y = 350+(grupo+1)*10
         ============================================================ -->

    <comp lib="0" loc="(1200,360)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="3"/>
      <a name="label" val="NEXT_STATE[2:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1200,370)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="COND_EN"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1200,380)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="Q_LOAD"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1200,390)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="DF_LOAD"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1200,400)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="REG_DEC"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1200,410)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="REG_INC"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1200,420)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="IR_LOAD"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1200,430)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="MEM_WR"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1200,440)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="MEM_RD"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1200,450)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="4"/>
      <a name="label" val="REG_SEL_SRC[3:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1200,460)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="3"/>
      <a name="label" val="ADDR_SRC[2:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1200,470)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="4"/>
      <a name="label" val="DST[3:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1200,480)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="3"/>
      <a name="label" val="SRC_B[2:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1200,490)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="3"/>
      <a name="label" val="SRC_A[2:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1200,500)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="4"/>
      <a name="label" val="ALU_OP[3:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1200,540)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="3"/>
      <a name="label" val="ESTADO_OUT[2:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <!-- ============================================================
         FIOS
         ============================================================ -->

    <!--
      INSTR_CLASS[5:0] -> ADDR_COMBINER grupo 1 (630,370)
      Rota: vai direita ate x=580, desce ate y=370, vai direita ate x=630
    -->
    <wire from="(100,200)" to="(580,200)"/>
    <wire from="(580,200)" to="(580,370)"/>
    <wire from="(580,370)" to="(630,370)"/>

    <!--
      REG_ESTADO Q (460,400) -> ADDR_COMBINER grupo 0 (630,360)
      Rota: sobe de y=400 a y=360, vai direita ate x=630
      T-juncao em (460,400) com ESTADO_OUT (ambos 3b)
    -->
    <wire from="(460,400)" to="(460,360)"/>
    <wire from="(460,360)" to="(630,360)"/>

    <!--
      ADDR_COMBINER tronco (9b) -> uROM endereco
    -->
    <wire from="(650,350)" to="(760,350)"/>

    <!--
      uROM dados (32b) -> MW_SPLITTER tronco
    -->
    <wire from="(830,350)" to="(1020,350)"/>

    <!--
      CLK -> REG_ESTADO CK (400,440)
    -->
    <wire from="(100,440)" to="(400,440)"/>

    <!--
      RESET -> REG_ESTADO CLR (430,460)
      Rota: vai direita ate x=250, sobe de y=480 a y=460, vai direita ate x=430
    -->
    <wire from="(100,480)" to="(250,480)"/>
    <wire from="(250,480)" to="(250,460)"/>
    <wire from="(250,460)" to="(430,460)"/>

    <!--
      MW_SPLITTER saidas -> pinos de saida
      x=1000 -> x=1200 (grupo i em y=350+(i+1)*10)
    -->
    <wire from="(1000,360)" to="(1200,360)"/>
    <wire from="(1000,370)" to="(1200,370)"/>
    <wire from="(1000,380)" to="(1200,380)"/>
    <wire from="(1000,390)" to="(1200,390)"/>
    <wire from="(1000,400)" to="(1200,400)"/>
    <wire from="(1000,410)" to="(1200,410)"/>
    <wire from="(1000,420)" to="(1200,420)"/>
    <wire from="(1000,430)" to="(1200,430)"/>
    <wire from="(1000,440)" to="(1200,440)"/>
    <wire from="(1000,450)" to="(1200,450)"/>
    <wire from="(1000,460)" to="(1200,460)"/>
    <wire from="(1000,470)" to="(1200,470)"/>
    <wire from="(1000,480)" to="(1200,480)"/>
    <wire from="(1000,490)" to="(1200,490)"/>
    <wire from="(1000,500)" to="(1200,500)"/>

    <!--
      NEXT_STATE realimentacao: MW_SPLITTER g0 (1000,360) -> REG_ESTADO D (400,400)
      Rota: sobe a y=340 (acima do tronco em y=350),
            vai esquerda ate x=395 (a esquerda de D em x=400),
            desce a y=400 (nivel de D),
            vai direita ate D (400,400).
      T-juncao em (1000,360) com fio de saida NEXT_STATE (ambos 3b).
      Cruzamento interior em (580,340): INSTR_CLASS 6b x feedback 3b (sem juncao).
    -->
    <wire from="(1000,360)" to="(1000,340)"/>
    <wire from="(1000,340)" to="(395,340)"/>
    <wire from="(395,340)" to="(395,400)"/>
    <wire from="(395,400)" to="(400,400)"/>

    <!--
      ESTADO_OUT: REG_ESTADO Q (460,400) -> pino ESTADO_OUT (1200,540)
      T-juncao em (460,400) com fio STATE (ambos 3b).
      Nao ha portas Register em x=460 no range y=[400,540] (CLR esta em 430,460 != x=460).
    -->
    <wire from="(460,400)" to="(460,540)"/>
    <wire from="(460,540)" to="(1200,540)"/>

  </circuit>
</project>

