<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="4.0.0" version="1.0">
  This file is intended to be loaded by Logisim-evolution v4.0.0(https://github.com/logisim-evolution/).

  <lib desc="#Wiring" name="0">
    <tool name="Pin">
      <a name="appearance" val="classic"/>
    </tool>
  </lib>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#TTL" name="6"/>
  <lib desc="#TCL" name="7"/>
  <lib desc="#Base" name="8"/>
  <lib desc="#BFH-Praktika" name="9"/>
  <lib desc="#Input/Output-Extra" name="10"/>
  <lib desc="#Soc" name="11"/>
  <main name="controle"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <mappings>
    <tool lib="8" map="Button2" name="Poke Tool"/>
    <tool lib="8" map="Button3" name="Menu Tool"/>
    <tool lib="8" map="Ctrl Button1" name="Menu Tool"/>
  </mappings>
  <toolbar>
    <tool lib="8" name="Poke Tool"/>
    <tool lib="8" name="Edit Tool"/>
    <tool lib="8" name="Wiring Tool"/>
    <tool lib="8" name="Text Tool"/>
    <sep/>
    <tool lib="0" name="Pin"/>
    <tool lib="0" name="Pin">
      <a name="facing" val="west"/>
      <a name="type" val="output"/>
    </tool>
    <sep/>
    <tool lib="1" name="NOT Gate"/>
    <tool lib="1" name="AND Gate"/>
    <tool lib="1" name="OR Gate"/>
    <tool lib="1" name="XOR Gate"/>
    <tool lib="1" name="NAND Gate"/>
    <tool lib="1" name="NOR Gate"/>
    <sep/>
  </toolbar>

  <!--
    controle.circ - Unidade de Controle Microprogramada RCA CDP1802
    Logisim Evolution 4.0.0

    Coordenadas deslocadas (+400,+300) para centralizar o canvas.

    ADDR_COMBINER: loc=(770,510), facing=west, fanout=2, spacing=1
      offs = -(2/2)*10 = -10
      grupo 0 (INSTR_CLASS 6b): (750,500)
      grupo 1 (STATE       3b): (750,510)
      barramento saida      :   (770,510)

    MW_SPLITTER: loc=(1120,510), facing=east, fanout=15, spacing=1
      offs = -(15/2)*10 = -70
      barramento entrada (32b): (1120,510)
      portas individuais: x=1140, y = 440 + grupo*10
        grupo  0 (ALU_OP      4b): (1140,440)
        grupo  7 (MEM_WR      1b): (1140,510)  <- mesmo y do barramento; gap x=20 evita T-junction
        grupo 14 (NEXT_STATE  3b): (1140,580)

    Rota do barramento ROM->MW_SPLITTER: (950,510)->(1120,510)  [direto, sem conflito]
    Rota NEXT_STATE realimentacao:
      (1140,580)->(1140,660)->(650,660)->(650,610)->(580,610)
      x=650 evita cruzar o fio vertical ESTADO_OUT em x=640.
  -->

  <circuit name="controle">
    <a name="appearance" val="logisim_evolution"/>

    <!-- PINOS DE ENTRADA -->

    <comp lib="0" loc="(430,430)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="6"/>
      <a name="label" val="INSTR_CLASS[5:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(430,600)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="1"/>
      <a name="label" val="CLK"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(430,640)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="1"/>
      <a name="label" val="RESET"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(430,680)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="1"/>
      <a name="label" val="DF"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(430,710)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="1"/>
      <a name="label" val="Q_IN"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(430,740)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="4"/>
      <a name="label" val="EF[3:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(430,770)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="1"/>
      <a name="label" val="D_ZERO"/>
      <a name="facing" val="east"/>
    </comp>

    <!-- REGISTRADOR DE ESTADO (3 bits): FETCH=000 EXECUTE1=001 EXECUTE2=010 -->
    <comp lib="4" loc="(610,600)" name="Register">
      <a name="width" val="3"/>
      <a name="label" val="REG_ESTADO"/>
    </comp>

    <!-- ADDR_COMBINER: ADDR[8:0] = { STATE[2:0], INSTR_CLASS[5:0] } -->
    <comp lib="0" loc="(770,510)" name="Splitter">
      <a name="facing" val="west"/>
      <a name="incoming" val="9"/>
      <a name="fanout" val="2"/>
      <a name="bit0" val="0"/>
      <a name="bit1" val="0"/>
      <a name="bit2" val="0"/>
      <a name="bit3" val="0"/>
      <a name="bit4" val="0"/>
      <a name="bit5" val="0"/>
      <a name="bit6" val="1"/>
      <a name="bit7" val="1"/>
      <a name="bit8" val="1"/>
      <a name="label" val="ADDR_COMBINER"/>
    </comp>

    <!-- uROM: 512x32 bits — botao direito -> Load Image -> uROM.mem -->
    <comp lib="4" loc="(910,510)" name="ROM">
      <a name="addrWidth" val="9"/>
      <a name="dataWidth" val="32"/>
      <a name="label" val="uROM"/>
    </comp>

    <!-- MW_SPLITTER: facing=east evita T-junction barramento x MEM_WR no y=510 -->
    <comp lib="0" loc="(1120,510)" name="Splitter">
      <a name="facing" val="east"/>
      <a name="incoming" val="32"/>
      <a name="fanout" val="15"/>
      <a name="bit0"  val="14"/>
      <a name="bit1"  val="14"/>
      <a name="bit2"  val="14"/>
      <a name="bit3"  val="13"/>
      <a name="bit4"  val="12"/>
      <a name="bit5"  val="11"/>
      <a name="bit6"  val="10"/>
      <a name="bit7"  val="9"/>
      <a name="bit8"  val="8"/>
      <a name="bit9"  val="7"/>
      <a name="bit10" val="6"/>
      <a name="bit11" val="5"/>
      <a name="bit12" val="5"/>
      <a name="bit13" val="5"/>
      <a name="bit14" val="5"/>
      <a name="bit15" val="4"/>
      <a name="bit16" val="4"/>
      <a name="bit17" val="4"/>
      <a name="bit18" val="3"/>
      <a name="bit19" val="3"/>
      <a name="bit20" val="3"/>
      <a name="bit21" val="3"/>
      <a name="bit22" val="2"/>
      <a name="bit23" val="2"/>
      <a name="bit24" val="2"/>
      <a name="bit25" val="1"/>
      <a name="bit26" val="1"/>
      <a name="bit27" val="1"/>
      <a name="bit28" val="0"/>
      <a name="bit29" val="0"/>
      <a name="bit30" val="0"/>
      <a name="bit31" val="0"/>
      <a name="label" val="MW_SPLITTER"/>
    </comp>

    <!-- PINOS DE SAIDA (x=1300, y=440+grupo*10) -->

    <comp lib="0" loc="(1300,440)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="4"/>
      <a name="label" val="ALU_OP[3:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1300,450)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="3"/>
      <a name="label" val="SRC_A[2:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1300,460)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="3"/>
      <a name="label" val="SRC_B[2:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1300,470)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="4"/>
      <a name="label" val="DST[3:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1300,480)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="3"/>
      <a name="label" val="ADDR_SRC[2:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1300,490)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="4"/>
      <a name="label" val="REG_SEL_SRC[3:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1300,500)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="MEM_RD"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1300,510)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="MEM_WR"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1300,520)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="IR_LOAD"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1300,530)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="REG_INC"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1300,540)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="REG_DEC"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1300,550)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="DF_LOAD"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1300,560)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="Q_LOAD"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1300,570)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="COND_EN"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1300,580)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="3"/>
      <a name="label" val="NEXT_STATE[2:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1300,700)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="3"/>
      <a name="label" val="ESTADO_OUT[2:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <!-- FIOS -->

    <!-- INSTR_CLASS[5:0] -> ADDR_COMBINER grupo 0 (750,500) -->
    <wire from="(430,430)" to="(630,430)"/>
    <wire from="(630,430)" to="(630,500)"/>
    <wire from="(630,500)" to="(750,500)"/>

    <!-- REG_ESTADO Q (640,600) -> ADDR_COMBINER grupo 1 (750,510) [STATE] -->
    <wire from="(640,600)" to="(670,600)"/>
    <wire from="(670,600)" to="(670,510)"/>
    <wire from="(670,510)" to="(750,510)"/>

    <!-- ADDR_COMBINER barramento (770,510) -> ROM endereco (880,510) -->
    <wire from="(770,510)" to="(880,510)"/>

    <!-- ROM dados (950,510) -> MW_SPLITTER barramento (1120,510) -->
    <wire from="(950,510)" to="(1120,510)"/>

    <!-- CLK (430,600) -> REG_ESTADO CK (580,600) -->
    <wire from="(430,600)" to="(580,600)"/>

    <!-- RESET (430,640) -> REG_ESTADO CLR (600,590) -->
    <wire from="(430,640)" to="(570,640)"/>
    <wire from="(570,640)" to="(570,590)"/>
    <wire from="(570,590)" to="(600,590)"/>

    <!-- MW_SPLITTER saidas (facing=east, portas em x=1140, y=440+grupo*10) -->
    <wire from="(1140,440)" to="(1300,440)"/>
    <wire from="(1140,450)" to="(1300,450)"/>
    <wire from="(1140,460)" to="(1300,460)"/>
    <wire from="(1140,470)" to="(1300,470)"/>
    <wire from="(1140,480)" to="(1300,480)"/>
    <wire from="(1140,490)" to="(1300,490)"/>
    <wire from="(1140,500)" to="(1300,500)"/>
    <wire from="(1140,510)" to="(1300,510)"/>
    <wire from="(1140,520)" to="(1300,520)"/>
    <wire from="(1140,530)" to="(1300,530)"/>
    <wire from="(1140,540)" to="(1300,540)"/>
    <wire from="(1140,550)" to="(1300,550)"/>
    <wire from="(1140,560)" to="(1300,560)"/>
    <wire from="(1140,570)" to="(1300,570)"/>
    <wire from="(1140,580)" to="(1300,580)"/>

    <!--
      NEXT_STATE realimentacao: grupo 14 (1140,580) -> REG_ESTADO D (580,610)
      Desce ate y=660, volta para x=650 (nao x=640 para evitar cruzar ESTADO_OUT),
      depois sobe para y=610 e vai ate a porta D.
    -->
    <wire from="(1140,580)" to="(1140,660)"/>
    <wire from="(1140,660)" to="(650,660)"/>
    <wire from="(650,660)"  to="(650,610)"/>
    <wire from="(650,610)"  to="(580,610)"/>

    <!-- ESTADO_OUT: REG_ESTADO Q (640,600) desce ate y=700 e segue para o pino -->
    <wire from="(640,600)" to="(640,700)"/>
    <wire from="(640,700)" to="(1300,700)"/>

  </circuit>
</project>
