<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="4.0.0" version="1.0">
  This file is intended to be loaded by Logisim-evolution v4.0.0(https://github.com/logisim-evolution/).

  <lib desc="#Wiring" name="0">
    <tool name="Pin">
      <a name="appearance" val="classic"/>
    </tool>
  </lib>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#TTL" name="6"/>
  <lib desc="#TCL" name="7"/>
  <lib desc="#Base" name="8"/>
  <lib desc="#BFH-Praktika" name="9"/>
  <lib desc="#Input/Output-Extra" name="10"/>
  <lib desc="#Soc" name="11"/>
  <main name="controle"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <mappings>
    <tool lib="8" map="Button2" name="Poke Tool"/>
    <tool lib="8" map="Button3" name="Menu Tool"/>
    <tool lib="8" map="Ctrl Button1" name="Menu Tool"/>
  </mappings>
  <toolbar>
    <tool lib="8" name="Poke Tool"/>
    <tool lib="8" name="Edit Tool"/>
    <tool lib="8" name="Wiring Tool"/>
    <tool lib="8" name="Text Tool"/>
    <sep/>
    <tool lib="0" name="Pin"/>
    <tool lib="0" name="Pin">
      <a name="facing" val="west"/>
      <a name="type" val="output"/>
    </tool>
    <sep/>
    <tool lib="1" name="NOT Gate"/>
    <tool lib="1" name="AND Gate"/>
    <tool lib="1" name="OR Gate"/>
    <tool lib="1" name="XOR Gate"/>
    <tool lib="1" name="NAND Gate"/>
    <tool lib="1" name="NOR Gate"/>
    <sep/>
  </toolbar>

  <circuit name="controle">
    <a name="appearance" val="logisim_evolution"/>

    <!--
    ====================================================================
    MAPA POSICIONAL - Logisim Evolution 4.0.0
    ====================================================================

    Fluxo esquerda para direita:
      ENTRADAS (x=300) -> REG_ESTADO (x=500) -> ADDR_COMBINER (x=800)
        -> uROM (x=940) -> MW_SPLITTER (x=1200) -> SAIDAS (x=1400)

    Register EVOLUTION loc=(500,350), bounds=(500,350)-(560,440):
      Q   = (560, 380)   porta de saida do estado atual
      D   = (500, 380)   porta de entrada do proximo estado
      CK  = (500, 420)   clock
      CLR = (530, 440)   reset assincrono
      EN  = (500, 400)   nao conectado (escreve sempre)

    Splitter formula v4.0.0:  y_grupo_i = loc_y + (i+1)*10

    ADDR_COMBINER loc=(800,350), facing=west, fanout=2:
      grupo 0 (STATE    3b, bits 6-8): porta (780, 360)
      grupo 1 (INSTR    6b, bits 0-5): porta (780, 370)
      tronco 9b: (800,350) -> ROM addr (910,350)

    uROM loc=(940,350):
      Addr = (910, 350)
      Data = (980, 350)

    MW_SPLITTER loc=(1200,350), facing=west, fanout=15:
      grupo  0 (NEXT_STATE  3b, bits  0-2):  porta (1180, 360)
      grupo  1 (COND_EN     1b, bit   3  ):  porta (1180, 370)
      grupo  2 (Q_LOAD      1b, bit   4  ):  porta (1180, 380)
      grupo  3 (DF_LOAD     1b, bit   5  ):  porta (1180, 390)
      grupo  4 (REG_DEC     1b, bit   6  ):  porta (1180, 400)
      grupo  5 (REG_INC     1b, bit   7  ):  porta (1180, 410)
      grupo  6 (IR_LOAD     1b, bit   8  ):  porta (1180, 420)
      grupo  7 (MEM_WR      1b, bit   9  ):  porta (1180, 430)
      grupo  8 (MEM_RD      1b, bit  10  ):  porta (1180, 440)
      grupo  9 (REG_SEL_SRC 4b, bits 11-14): porta (1180, 450)
      grupo 10 (ADDR_SRC    3b, bits 15-17): porta (1180, 460)
      grupo 11 (DST         4b, bits 18-21): porta (1180, 470)
      grupo 12 (SRC_B       3b, bits 22-24): porta (1180, 480)
      grupo 13 (SRC_A       3b, bits 25-27): porta (1180, 490)
      grupo 14 (ALU_OP      4b, bits 28-31): porta (1180, 500)
      tronco 32b: (1200,350) <- ROM data (980,350)

    FIOS PRINCIPAIS (todos em multiplos de 10):
      INSTR_CLASS: (300,250)->(750,250)->(750,370)->(780,370)
      STATE(Q->ADDR): (560,380)->(560,360)->(780,360)
      ADDR -> ROM: (800,350)->(910,350)
      ROM  -> SPLIT: (980,350)->(1200,350)
      CLK  -> CK: (300,420)->(500,420)
      RESET -> CLR: (300,460)->(460,460)->(460,440)->(530,440)
      NEXT_STATE feedback: (1180,360)->(1180,330)->(490,330)->(490,380)->(500,380)
      ESTADO_OUT: (560,380)->(560,550)->(1400,550)

    Cruzamentos interiores (sem juncao):
      (750,360): INSTR_CLASS vertical(6b) x STATE horizontal(3b)
      (750,330): INSTR_CLASS vertical(6b) x feedback horizontal(3b)
    ====================================================================
    -->

    <!-- PINOS DE ENTRADA -->

    <comp lib="0" loc="(300,250)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="6"/>
      <a name="label" val="INSTR_CLASS[5:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(300,420)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="1"/>
      <a name="label" val="CLK"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(300,460)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="1"/>
      <a name="label" val="RESET"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(300,520)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="1"/>
      <a name="label" val="DF"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(300,550)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="1"/>
      <a name="label" val="Q_IN"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(300,580)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="4"/>
      <a name="label" val="EF[3:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(300,610)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="1"/>
      <a name="label" val="D_ZERO"/>
      <a name="facing" val="east"/>
    </comp>

    <!--
    REG_ESTADO - Register 3b, EVOLUTION appearance (padrao v4.0.0)
    loc=(500,350), bounds=(500,350)-(560,440)
    Portas (Register.java v4.0.0 APPEAR_EVOLUTION):
      Q   = (560,380)  [loc+(60,30)]
      D   = (500,380)  [loc+( 0,30)]
      CK  = (500,420)  [loc+( 0,70)]
      CLR = (530,440)  [loc+(30,90)]
      EN  = (500,400)  [loc+( 0,50)] nao conectado
    -->
    <comp lib="4" loc="(500,350)" name="Register">
      <a name="width" val="3"/>
      <a name="label" val="REG_ESTADO"/>
    </comp>

    <!--
    ADDR_COMBINER: ADDR[8:0] = {STATE[2:0], INSTR_CLASS[5:0]}
    Splitter facing=west, loc=(800,350), fanout=2, incoming=9
    v4.0.0: grupo 0 em y=360, grupo 1 em y=370
      bit6-8 -> grupo 0 (STATE  3b): porta (780,360)
      bit0-5 -> grupo 1 (INSTR  6b): porta (780,370)
    -->
    <comp lib="0" loc="(800,350)" name="Splitter">
      <a name="facing" val="west"/>
      <a name="incoming" val="9"/>
      <a name="fanout" val="2"/>
      <a name="bit0" val="1"/>
      <a name="bit1" val="1"/>
      <a name="bit2" val="1"/>
      <a name="bit3" val="1"/>
      <a name="bit4" val="1"/>
      <a name="bit5" val="1"/>
      <a name="bit6" val="0"/>
      <a name="bit7" val="0"/>
      <a name="bit8" val="0"/>
      <a name="label" val="ADDR_COMBINER"/>
    </comp>

    <!--
    uROM - ROM 512x32b (botao direito -> Load Image -> uROM.mem)
    loc=(940,350): Addr=(910,350)  Data=(980,350)
    -->
    <comp lib="4" loc="(940,350)" name="ROM">
      <a name="addrWidth" val="9"/>
      <a name="dataWidth" val="32"/>
      <a name="label" val="uROM"/>
    </comp>

    <!--
    MW_SPLITTER: decompoe micropalavra 32b nos 15 sinais de controle
    Splitter facing=west, loc=(1200,350), fanout=15, incoming=32
    v4.0.0: grupo i em y = 350+(i+1)*10
    bit-assignments INVERTIDOS para v4.0.0 (grupo 0=NEXT_STATE, grupo 14=ALU_OP)
    -->
    <comp lib="0" loc="(1200,350)" name="Splitter">
      <a name="facing" val="west"/>
      <a name="incoming" val="32"/>
      <a name="fanout" val="15"/>
      <a name="bit0"  val="0"/>
      <a name="bit1"  val="0"/>
      <a name="bit2"  val="0"/>
      <a name="bit3"  val="1"/>
      <a name="bit4"  val="2"/>
      <a name="bit5"  val="3"/>
      <a name="bit6"  val="4"/>
      <a name="bit7"  val="5"/>
      <a name="bit8"  val="6"/>
      <a name="bit9"  val="7"/>
      <a name="bit10" val="8"/>
      <a name="bit11" val="9"/>
      <a name="bit12" val="9"/>
      <a name="bit13" val="9"/>
      <a name="bit14" val="9"/>
      <a name="bit15" val="10"/>
      <a name="bit16" val="10"/>
      <a name="bit17" val="10"/>
      <a name="bit18" val="11"/>
      <a name="bit19" val="11"/>
      <a name="bit20" val="11"/>
      <a name="bit21" val="11"/>
      <a name="bit22" val="12"/>
      <a name="bit23" val="12"/>
      <a name="bit24" val="12"/>
      <a name="bit25" val="13"/>
      <a name="bit26" val="13"/>
      <a name="bit27" val="13"/>
      <a name="bit28" val="14"/>
      <a name="bit29" val="14"/>
      <a name="bit30" val="14"/>
      <a name="bit31" val="14"/>
      <a name="label" val="MW_SPLITTER"/>
    </comp>

    <!-- PINOS DE SAIDA x=1400, y=350+(grupo+1)*10 -->

    <comp lib="0" loc="(1400,360)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="3"/>
      <a name="label" val="NEXT_STATE[2:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1400,370)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="COND_EN"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1400,380)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="Q_LOAD"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1400,390)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="DF_LOAD"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1400,400)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="REG_DEC"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1400,410)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="REG_INC"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1400,420)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="IR_LOAD"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1400,430)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="MEM_WR"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1400,440)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="MEM_RD"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1400,450)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="4"/>
      <a name="label" val="REG_SEL_SRC[3:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1400,460)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="3"/>
      <a name="label" val="ADDR_SRC[2:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1400,470)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="4"/>
      <a name="label" val="DST[3:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1400,480)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="3"/>
      <a name="label" val="SRC_B[2:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1400,490)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="3"/>
      <a name="label" val="SRC_A[2:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1400,500)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="4"/>
      <a name="label" val="ALU_OP[3:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(1400,550)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="3"/>
      <a name="label" val="ESTADO_OUT[2:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <!-- FIOS -->

    <!-- INSTR_CLASS -> ADDR_COMBINER grupo 1 (780,370) -->
    <wire from="(300,250)" to="(750,250)"/>
    <wire from="(750,250)" to="(750,370)"/>
    <wire from="(750,370)" to="(780,370)"/>

    <!-- REG_ESTADO Q (560,380) -> ADDR_COMBINER grupo 0 (780,360) -->
    <wire from="(560,380)" to="(560,360)"/>
    <wire from="(560,360)" to="(780,360)"/>

    <!-- ADDR_COMBINER tronco -> uROM addr -->
    <wire from="(800,350)" to="(910,350)"/>

    <!-- uROM data -> MW_SPLITTER tronco -->
    <wire from="(980,350)" to="(1200,350)"/>

    <!-- CLK -> REG_ESTADO CK (500,420) -->
    <wire from="(300,420)" to="(500,420)"/>

    <!-- RESET -> REG_ESTADO CLR (530,440) -->
    <wire from="(300,460)" to="(460,460)"/>
    <wire from="(460,460)" to="(460,440)"/>
    <wire from="(460,440)" to="(530,440)"/>

    <!-- MW_SPLITTER saidas -> pinos -->
    <wire from="(1180,360)" to="(1400,360)"/>
    <wire from="(1180,370)" to="(1400,370)"/>
    <wire from="(1180,380)" to="(1400,380)"/>
    <wire from="(1180,390)" to="(1400,390)"/>
    <wire from="(1180,400)" to="(1400,400)"/>
    <wire from="(1180,410)" to="(1400,410)"/>
    <wire from="(1180,420)" to="(1400,420)"/>
    <wire from="(1180,430)" to="(1400,430)"/>
    <wire from="(1180,440)" to="(1400,440)"/>
    <wire from="(1180,450)" to="(1400,450)"/>
    <wire from="(1180,460)" to="(1400,460)"/>
    <wire from="(1180,470)" to="(1400,470)"/>
    <wire from="(1180,480)" to="(1400,480)"/>
    <wire from="(1180,490)" to="(1400,490)"/>
    <wire from="(1180,500)" to="(1400,500)"/>

    <!--
    NEXT_STATE realimentacao: MW_SPLITTER g0 (1180,360) -> REG_ESTADO D (500,380)
    Rota: sobe y=330, vai ate x=490, desce y=380, entra em D pela esquerda.
    T-juncao em (1180,360) com fio de saida NEXT_STATE (ambos 3b).
    Cruzamentos interiores em y=330: INSTR_CLASS(6b) em x=750 (sem juncao).
    -->
    <wire from="(1180,360)" to="(1180,330)"/>
    <wire from="(1180,330)" to="(490,330)"/>
    <wire from="(490,330)" to="(490,380)"/>
    <wire from="(490,380)" to="(500,380)"/>

    <!--
    ESTADO_OUT: REG_ESTADO Q (560,380) -> pino ESTADO_OUT (1400,550)
    T-juncao em (560,380) com fio STATE (ambos 3b).
    Nao passa por nenhuma porta do Register.
    -->
    <wire from="(560,380)" to="(560,550)"/>
    <wire from="(560,550)" to="(1400,550)"/>

  </circuit>
</project>
