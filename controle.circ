      <a name="incoming" val="32"/>
      <a name="fanout" val="15"/>
      <a name="spacing" val="3"/>
      <a name="bit0"  val="0"/>
      <a name="bit1"  val="0"/>
      <a name="bit2"  val="0"/>
      <a name="bit3"  val="1"/>
