  <circuit name="controle">
    <a name="appearance" val="logisim_evolution"/>

    <!--
    CONTROLE RCA-1802  Logisim Evolution 4.0.0
    Base eletrica: commit 62db65f (0 erros de largura)
    Layout: margem esquerda 500px, fluxo esquerda -> direita

      ENTRADAS(500) -> REG_ESTADO(800) -> ADDR_COMBINER(1050)
        -> uROM(1190) -> MW_SPLITTER(1520, spacing=3) -> SAIDAS(1800)

    Register EVOLUTION loc=(800,370):
      Q=(860,400)  D=(800,400)  CK=(800,440)  CLR=(830,460)

    ADDR_COMBINER facing=west loc=(1050,350) fanout=2:
      STATE 3b -> (1030,360)   INSTR 6b -> (1030,370)   tronco -> (1160,350)

    uROM loc=(1190,350):  Addr=(1160,350)  Data=(1230,350)

    MW_SPLITTER facing=west loc=(1520,350) fanout=15 spacing=3:
      porta_i = (1500, 360 + i*30), i=0..14
      tronco 32b = (1520,350) <- ROM data (1230,350)
    -->

    <!-- ENTRADAS -->

    <comp lib="0" loc="(500,200)" name="Pin">
