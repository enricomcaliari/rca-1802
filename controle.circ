<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="4.0.0" version="1.0">
  This file is intended to be loaded by Logisim-evolution v4.0.0(https://github.com/logisim-evolution/).

  <lib desc="#Wiring" name="0">
    <tool name="Pin">
      <a name="appearance" val="classic"/>
    </tool>
  </lib>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#TTL" name="6"/>
  <lib desc="#TCL" name="7"/>
  <lib desc="#Base" name="8"/>
  <lib desc="#BFH-Praktika" name="9"/>
  <lib desc="#Input/Output-Extra" name="10"/>
  <lib desc="#Soc" name="11"/>
  <main name="controle"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <mappings>
    <tool lib="8" map="Button2" name="Poke Tool"/>
    <tool lib="8" map="Button3" name="Menu Tool"/>
    <tool lib="8" map="Ctrl Button1" name="Menu Tool"/>
  </mappings>
  <toolbar>
    <tool lib="8" name="Poke Tool"/>
    <tool lib="8" name="Edit Tool"/>
    <tool lib="8" name="Wiring Tool"/>
    <tool lib="8" name="Text Tool"/>
    <sep/>
    <tool lib="0" name="Pin"/>
    <tool lib="0" name="Pin">
      <a name="facing" val="west"/>
      <a name="type" val="output"/>
    </tool>
    <sep/>
    <tool lib="1" name="NOT Gate"/>
    <tool lib="1" name="AND Gate"/>
    <tool lib="1" name="OR Gate"/>
    <tool lib="1" name="XOR Gate"/>
    <tool lib="1" name="NAND Gate"/>
    <tool lib="1" name="NOR Gate"/>
    <sep/>
  </toolbar>

  <circuit name="controle">

    <!-- ============================================================
         PINOS DE ENTRADA
         ============================================================ -->

    <comp lib="0" loc="(30,130)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="6"/>
      <a name="label" val="INSTR_CLASS[5:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(30,300)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="1"/>
      <a name="label" val="CLK"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(30,340)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="1"/>
      <a name="label" val="RESET"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(30,380)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="1"/>
      <a name="label" val="DF"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(30,410)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="1"/>
      <a name="label" val="Q_IN"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(30,440)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="4"/>
      <a name="label" val="EF[3:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(30,470)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="1"/>
      <a name="label" val="D_ZERO"/>
      <a name="facing" val="east"/>
    </comp>

    <!-- ============================================================
         REGISTRADOR DE ESTADO (FSM) - 3 bits
         FETCH=000  EXECUTE1=001  EXECUTE2=010
         ============================================================ -->
    <comp lib="4" loc="(210,300)" name="Register">
      <a name="width" val="3"/>
      <a name="label" val="REG_ESTADO"/>
    </comp>

    <!-- ============================================================
         COMBINADOR DE ENDERECO
         ADDR[8:0] = { STATE[2:0], INSTR_CLASS[5:0] }
         Splitter: incoming=9, fanout=2
           grupo 0 (bits 5-0) <- INSTR_CLASS[5:0]  porta y=loc_y+20=230
           grupo 1 (bits 8-6) <- STATE[2:0]         porta y=loc_y+10=220
         ============================================================ -->
    <comp lib="0" loc="(370,210)" name="Splitter">
      <a name="facing" val="west"/>
      <a name="incoming" val="9"/>
      <a name="fanout" val="2"/>
      <a name="bit0" val="0"/>
      <a name="bit1" val="0"/>
      <a name="bit2" val="0"/>
      <a name="bit3" val="0"/>
      <a name="bit4" val="0"/>
      <a name="bit5" val="0"/>
      <a name="bit6" val="1"/>
      <a name="bit7" val="1"/>
      <a name="bit8" val="1"/>
      <a name="label" val="ADDR_COMBINER"/>
    </comp>

    <!-- ============================================================
         uROM - 512 x 32 bits
         Botao direito -> Load Image -> uROM.mem
         ============================================================ -->
    <comp lib="4" loc="(510,210)" name="ROM">
      <a name="addrWidth" val="9"/>
      <a name="dataWidth" val="32"/>
      <a name="label" val="uROM"/>
    </comp>

    <!-- ============================================================
         SPLITTER DE SAIDA - decompoe a micropalavra (32 bits)
         facing=west, loc=(720,210), fanout=15
         Porta i em x=700, y=210+(15-i)*10
           grupo  0: bits 31-28 -> ALU_OP[3:0]       y=360
           grupo  1: bits 27-25 -> SRC_A[2:0]        y=350
           grupo  2: bits 24-22 -> SRC_B[2:0]        y=340
           grupo  3: bits 21-18 -> DST[3:0]          y=330
           grupo  4: bits 17-15 -> ADDR_SRC[2:0]     y=320
           grupo  5: bits 14-11 -> REG_SEL_SRC[3:0]  y=310
           grupo  6: bit  10    -> MEM_RD             y=300
           grupo  7: bit   9    -> MEM_WR             y=290
           grupo  8: bit   8    -> IR_LOAD            y=280
           grupo  9: bit   7    -> REG_INC            y=270
           grupo 10: bit   6    -> REG_DEC            y=260
           grupo 11: bit   5    -> DF_LOAD            y=250
           grupo 12: bit   4    -> Q_LOAD             y=240
           grupo 13: bit   3    -> COND_EN            y=230
           grupo 14: bits  2-0  -> NEXT_STATE[2:0]   y=220
         ============================================================ -->
    <comp lib="0" loc="(720,210)" name="Splitter">
      <a name="facing" val="west"/>
      <a name="incoming" val="32"/>
      <a name="fanout" val="15"/>
      <a name="bit0"  val="14"/>
      <a name="bit1"  val="14"/>
      <a name="bit2"  val="14"/>
      <a name="bit3"  val="13"/>
      <a name="bit4"  val="12"/>
      <a name="bit5"  val="11"/>
      <a name="bit6"  val="10"/>
      <a name="bit7"  val="9"/>
      <a name="bit8"  val="8"/>
      <a name="bit9"  val="7"/>
      <a name="bit10" val="6"/>
      <a name="bit11" val="5"/>
      <a name="bit12" val="5"/>
      <a name="bit13" val="5"/>
      <a name="bit14" val="5"/>
      <a name="bit15" val="4"/>
      <a name="bit16" val="4"/>
      <a name="bit17" val="4"/>
      <a name="bit18" val="3"/>
      <a name="bit19" val="3"/>
      <a name="bit20" val="3"/>
      <a name="bit21" val="3"/>
      <a name="bit22" val="2"/>
      <a name="bit23" val="2"/>
      <a name="bit24" val="2"/>
      <a name="bit25" val="1"/>
      <a name="bit26" val="1"/>
      <a name="bit27" val="1"/>
      <a name="bit28" val="0"/>
      <a name="bit29" val="0"/>
      <a name="bit30" val="0"/>
      <a name="bit31" val="0"/>
      <a name="label" val="MW_SPLITTER"/>
    </comp>

    <!-- ============================================================
         PINOS DE SAIDA
         Posicionados em y = 210 + (15 - grupo) * 10  (x=900)
         ============================================================ -->

    <comp lib="0" loc="(900,360)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="4"/>
      <a name="label" val="ALU_OP[3:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(900,350)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="3"/>
      <a name="label" val="SRC_A[2:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(900,340)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="3"/>
      <a name="label" val="SRC_B[2:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(900,330)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="4"/>
      <a name="label" val="DST[3:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(900,320)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="3"/>
      <a name="label" val="ADDR_SRC[2:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(900,310)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="4"/>
      <a name="label" val="REG_SEL_SRC[3:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(900,300)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="MEM_RD"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(900,290)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="MEM_WR"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(900,280)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="IR_LOAD"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(900,270)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="REG_INC"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(900,260)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="REG_DEC"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(900,250)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="DF_LOAD"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(900,240)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="Q_LOAD"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(900,230)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="COND_EN"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(900,220)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="3"/>
      <a name="label" val="NEXT_STATE[2:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(900,400)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="3"/>
      <a name="label" val="ESTADO_OUT[2:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <!-- ============================================================
         FIOS
         ============================================================ -->

    <!-- INSTR_CLASS[5:0] -> ADDR_COMBINER grupo 0 (porta x=350, y=loc_y+20=230) -->
    <wire from="(30,130)" to="(200,130)"/>
    <wire from="(200,130)" to="(200,230)"/>
    <wire from="(200,230)" to="(350,230)"/>

    <!-- REG_ESTADO Q -> ADDR_COMBINER grupo 1 (porta x=350, y=loc_y+10=220) -->
    <wire from="(240,300)" to="(270,300)"/>
    <wire from="(270,300)" to="(270,220)"/>
    <wire from="(270,220)" to="(350,220)"/>

    <!-- ADDR_COMBINER saida (9 bits) -> uROM endereco -->
    <wire from="(370,210)" to="(480,210)"/>

    <!-- uROM dados (32 bits) -> MW_SPLITTER -->
    <wire from="(550,210)" to="(720,210)"/>

    <!-- CLK -> REG_ESTADO CK -->
    <wire from="(30,300)" to="(180,300)"/>

    <!-- RESET -> REG_ESTADO CLR -->
    <wire from="(30,340)" to="(170,340)"/>
    <wire from="(170,340)" to="(170,290)"/>
    <wire from="(170,290)" to="(200,290)"/>

    <!-- MW_SPLITTER saidas (x=700) -> pinos de saida (x=900) -->
    <wire from="(700,360)" to="(900,360)"/>
    <wire from="(700,350)" to="(900,350)"/>
    <wire from="(700,340)" to="(900,340)"/>
    <wire from="(700,330)" to="(900,330)"/>
    <wire from="(700,320)" to="(900,320)"/>
    <wire from="(700,310)" to="(900,310)"/>
    <wire from="(700,300)" to="(900,300)"/>
    <wire from="(700,290)" to="(900,290)"/>
    <wire from="(700,280)" to="(900,280)"/>
    <wire from="(700,270)" to="(900,270)"/>
    <wire from="(700,260)" to="(900,260)"/>
    <wire from="(700,250)" to="(900,250)"/>
    <wire from="(700,240)" to="(900,240)"/>
    <wire from="(700,230)" to="(900,230)"/>
    <wire from="(700,220)" to="(900,220)"/>

    <!-- NEXT_STATE realimentacao: porta (700,220) -> REG_ESTADO D (180,310) -->
    <wire from="(700,220)" to="(700,200)"/>
    <wire from="(700,200)" to="(205,200)"/>
    <wire from="(205,200)" to="(205,310)"/>
    <wire from="(205,310)" to="(180,310)"/>

    <!-- ESTADO_OUT: REG_ESTADO Q (240,300) -> pino (900,400) -->
    <wire from="(240,300)" to="(260,300)"/>
    <wire from="(260,300)" to="(260,400)"/>
    <wire from="(260,400)" to="(900,400)"/>

  </circuit>
</project>
