<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project source="4.0.0" version="1.0">
  This file is intended to be loaded by Logisim-evolution v4.0.0(https://github.com/logisim-evolution/).

  <lib desc="#Wiring" name="0">
    <tool name="Pin">
      <a name="appearance" val="classic"/>
    </tool>
  </lib>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#TTL" name="6"/>
  <lib desc="#TCL" name="7"/>
  <lib desc="#Base" name="8"/>
  <lib desc="#BFH-Praktika" name="9"/>
  <lib desc="#Input/Output-Extra" name="10"/>
  <lib desc="#Soc" name="11"/>
  <main name="controle"/>
  <options>
    <a name="gateUndefined" val="ignore"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>
  <mappings>
    <tool lib="8" map="Button2" name="Poke Tool"/>
    <tool lib="8" map="Button3" name="Menu Tool"/>
    <tool lib="8" map="Ctrl Button1" name="Menu Tool"/>
  </mappings>
  <toolbar>
    <tool lib="8" name="Poke Tool"/>
    <tool lib="8" name="Edit Tool"/>
    <tool lib="8" name="Wiring Tool"/>
    <tool lib="8" name="Text Tool"/>
    <sep/>
    <tool lib="0" name="Pin"/>
    <tool lib="0" name="Pin">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
    </tool>
    <sep/>
    <tool lib="1" name="NOT Gate"/>
    <tool lib="1" name="AND Gate"/>
    <tool lib="1" name="OR Gate"/>
    <tool lib="1" name="XOR Gate"/>
    <tool lib="1" name="NAND Gate"/>
    <tool lib="1" name="NOR Gate"/>
    <sep/>
  </toolbar>

  <circuit name="controle">
    <a name="appearance" val="logisim_evolution"/>

    <!--
    CONTROLE RCA-1802  Logisim Evolution 4.0.0
    ==========================================
    Fluxo esquerda -> direita:

      ENTRADAS(x=300) -> REG_ESTADO(x=600) -> ADDR_COMBINER(x=850)
        -> uROM(x=990) -> MW_SPLITTER(x=1220) -> SAIDAS(x=1400)

    Coordenadas todos em multiplos de 10.
    Margem esquerda: 300px  |  Margem topo: 200px

    REG_ESTADO  loc=(600,370)  width=3  APPEAR_EVOLUTION
      Q   = (660, 400)  saida estado atual
      D   = (600, 400)  entrada proximo estado (NEXT_STATE realimentacao)
      CK  = (600, 440)  clock
      CLR = (630, 460)  reset assincrono
      EN  = (600, 420)  nao conectado

    ADDR_COMBINER  Splitter facing=west  loc=(850,350)  incoming=9  fanout=2
      v4.0.0: porta_i_x = loc_x - 20 = 830
              porta_i_y = loc_y + (i+1)*10
      grupo 0  STATE[2:0]    bits 6-8  3b  porta (830,360)
      grupo 1  INSTR[5:0]    bits 0-5  6b  porta (830,370)
      tronco 9b: loc=(850,350) -> uROM.addr (960,350)

    uROM  ROM 512x32  loc=(990,350)
      addr = (loc_x-30, loc_y) = (960, 350)
      data = (loc_x+40, loc_y) = (1030,350)

    MW_SPLITTER  Splitter facing=west  loc=(1220,350)  incoming=32  fanout=15
      grupo  0  NEXT_STATE[2:0]  bits  0-2   3b  porta (1200,360)
      grupo  1  COND_EN          bit   3      1b  porta (1200,370)
      grupo  2  Q_LOAD           bit   4      1b  porta (1200,380)
      grupo  3  DF_LOAD          bit   5      1b  porta (1200,390)
      grupo  4  REG_DEC          bit   6      1b  porta (1200,400)
      grupo  5  REG_INC          bit   7      1b  porta (1200,410)
      grupo  6  IR_LOAD          bit   8      1b  porta (1200,420)
      grupo  7  MEM_WR           bit   9      1b  porta (1200,430)
      grupo  8  MEM_RD           bit  10      1b  porta (1200,440)
      grupo  9  REG_SEL_SRC[3:0] bits 11-14  4b  porta (1200,450)
      grupo 10  ADDR_SRC[2:0]    bits 15-17  3b  porta (1200,460)
      grupo 11  DST[3:0]         bits 18-21  4b  porta (1200,470)
      grupo 12  SRC_B[2:0]       bits 22-24  3b  porta (1200,480)
      grupo 13  SRC_A[2:0]       bits 25-27  3b  porta (1200,490)
      grupo 14  ALU_OP[3:0]      bits 28-31  4b  porta (1200,500)
      tronco 32b: loc=(1220,350) <- uROM.data (1030,350)

    FIOS:
      INSTR[5:0]:  (300,200)->(780,200)->(780,370)->(830,370)
      STATE:       (660,400)->(660,360)->(830,360)
      ADDR->ROM:   (850,350)->(960,350)
      ROM->SPLIT:  (1030,350)->(1220,350)
      CLK->CK:     (300,440)->(600,440)
      RESET->CLR:  (300,480)->(450,480)->(450,460)->(630,460)
      FEEDBACK:    (1200,360)->(1200,340)->(600,340)->(600,400)
      ESTADO_OUT:  (660,400)->(660,540)->(1400,540)
      SAIDAS:      (1200,360-500)->(1400,360-500)

    Cruzamentos interiores (sem juncao, sem erro de largura):
      (780,340): INSTR vertical(6b) x feedback horizontal(3b)
      (780,360): INSTR vertical(6b) x STATE horizontal(3b)
    -->

    <!-- PINOS DE ENTRADA -->

    <comp lib="0" loc="(300,200)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="6"/>
      <a name="label" val="INSTR_CLASS[5:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(300,440)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="1"/>
      <a name="label" val="CLK"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(300,480)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="1"/>
      <a name="label" val="RESET"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(300,520)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="1"/>
      <a name="label" val="DF"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(300,550)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="1"/>
      <a name="label" val="Q_IN"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(300,580)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="4"/>
      <a name="label" val="EF[3:0]"/>
      <a name="facing" val="east"/>
    </comp>

    <comp lib="0" loc="(300,610)" name="Pin">
      <a name="output" val="false"/>
      <a name="width" val="1"/>
      <a name="label" val="D_ZERO"/>
      <a name="facing" val="east"/>
    </comp>

    <!--
    REG_ESTADO: registrador de estado 3 bits, aparencia EVOLUTION
    loc=(600,370)  bounds=(600,370)-(660,460)
    Q=(660,400) D=(600,400) CK=(600,440) CLR=(630,460) EN=(600,420)
    -->
    <comp lib="4" loc="(600,370)" name="Register">
      <a name="width" val="3"/>
      <a name="label" val="REG_ESTADO"/>
    </comp>

    <!--
    ADDR_COMBINER: combina STATE(3b) + INSTR_CLASS(6b) = ADDR(9b) para uROM
    Splitter facing=west  loc=(850,350)  incoming=9  fanout=2
    Bit assignments INVERTIDOS para v4.0.0 (grupo 0 = bits altos = STATE):
      bit0-5 -> grupo 1 (INSTR_CLASS 6b)
      bit6-8 -> grupo 0 (STATE 3b)
    Portas: grupo0=(830,360)  grupo1=(830,370)  tronco=(850,350)
    -->
    <comp lib="0" loc="(850,350)" name="Splitter">
      <a name="facing" val="west"/>
      <a name="incoming" val="9"/>
      <a name="fanout" val="2"/>
      <a name="bit0" val="1"/>
      <a name="bit1" val="1"/>
      <a name="bit2" val="1"/>
      <a name="bit3" val="1"/>
      <a name="bit4" val="1"/>
      <a name="bit5" val="1"/>
      <a name="bit6" val="0"/>
      <a name="bit7" val="0"/>
      <a name="bit8" val="0"/>
      <a name="label" val="ADDR_COMBINER"/>
    </comp>

    <!--
    uROM: ROM 512 palavras x 32 bits
    Para carregar: botao direito -> Load Image -> uROM.mem
    loc=(990,350)  addr=(960,350)  data=(1030,350)
    -->
    <comp lib="4" loc="(990,350)" name="ROM">
      <a name="addrWidth" val="9"/>
      <a name="dataWidth" val="32"/>
      <a name="label" val="uROM"/>
    </comp>

    <!--
    MW_SPLITTER: decompose micropalavra 32b nos 15 sinais de controle
    Splitter facing=west  loc=(1220,350)  incoming=32  fanout=15
    Bit assignments INVERTIDOS para v4.0.0: grupo 0=NEXT_STATE, grupo 14=ALU_OP
    Portas: grupo_i=(1200, 360+i*10)  tronco=(1220,350)
    -->
    <comp lib="0" loc="(1220,350)" name="Splitter">
      <a name="facing" val="west"/>
      <a name="incoming" val="32"/>
      <a name="fanout" val="15"/>
      <a name="bit0"  val="0"/>
      <a name="bit1"  val="0"/>
      <a name="bit2"  val="0"/>
      <a name="bit3"  val="1"/>
      <a name="bit4"  val="2"/>
      <a name="bit5"  val="3"/>
      <a name="bit6"  val="4"/>
      <a name="bit7"  val="5"/>
      <a name="bit8"  val="6"/>
      <a name="bit9"  val="7"/>
      <a name="bit10" val="8"/>
      <a name="bit11" val="9"/>
      <a name="bit12" val="9"/>
      <a name="bit13" val="9"/>
      <a name="bit14" val="9"/>
      <a name="bit15" val="10"/>
      <a name="bit16" val="10"/>
      <a name="bit17" val="10"/>
      <a name="bit18" val="11"/>
      <a name="bit19" val="11"/>
      <a name="bit20" val="11"/>
      <a name="bit21" val="11"/>
      <a name="bit22" val="12"/>
      <a name="bit23" val="12"/>
      <a name="bit24" val="12"/>
      <a name="bit25" val="13"/>
      <a name="bit26" val="13"/>
      <a name="bit27" val="13"/>
      <a name="bit28" val="14"/>
      <a name="bit29" val="14"/>
      <a name="bit30" val="14"/>
      <a name="bit31" val="14"/>
      <a name="label" val="MW_SPLITTER"/>
    </comp>

    <!-- PINOS DE SAIDA x=1400 -->

    <comp lib="0" loc="(1400,360)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="3"/>
      <a name="label" val="NEXT_STATE[2:0]"/>
      <a name="facing" val="west"/>
    </comp>

    <comp lib="0" loc="(1400,370)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="COND_EN"/>
      <a name="facing" val="west"/>
    </comp>

    <comp lib="0" loc="(1400,380)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="Q_LOAD"/>
      <a name="facing" val="west"/>
    </comp>

    <comp lib="0" loc="(1400,390)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="DF_LOAD"/>
      <a name="facing" val="west"/>
    </comp>

    <comp lib="0" loc="(1400,400)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="REG_DEC"/>
      <a name="facing" val="west"/>
    </comp>

    <comp lib="0" loc="(1400,410)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="REG_INC"/>
      <a name="facing" val="west"/>
    </comp>

    <comp lib="0" loc="(1400,420)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="IR_LOAD"/>
      <a name="facing" val="west"/>
    </comp>

    <comp lib="0" loc="(1400,430)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="MEM_WR"/>
      <a name="facing" val="west"/>
    </comp>

    <comp lib="0" loc="(1400,440)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="1"/>
      <a name="label" val="MEM_RD"/>
      <a name="facing" val="west"/>
    </comp>

    <comp lib="0" loc="(1400,450)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="4"/>
      <a name="label" val="REG_SEL_SRC[3:0]"/>
      <a name="facing" val="west"/>
    </comp>

    <comp lib="0" loc="(1400,460)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="3"/>
      <a name="label" val="ADDR_SRC[2:0]"/>
      <a name="facing" val="west"/>
    </comp>

    <comp lib="0" loc="(1400,470)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="4"/>
      <a name="label" val="DST[3:0]"/>
      <a name="facing" val="west"/>
    </comp>

    <comp lib="0" loc="(1400,480)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="3"/>
      <a name="label" val="SRC_B[2:0]"/>
      <a name="facing" val="west"/>
    </comp>

    <comp lib="0" loc="(1400,490)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="3"/>
      <a name="label" val="SRC_A[2:0]"/>
      <a name="facing" val="west"/>
    </comp>

    <comp lib="0" loc="(1400,500)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="4"/>
      <a name="label" val="ALU_OP[3:0]"/>
      <a name="facing" val="west"/>
    </comp>

    <comp lib="0" loc="(1400,540)" name="Pin">
      <a name="output" val="true"/>
      <a name="width" val="3"/>
      <a name="label" val="ESTADO_OUT[2:0]"/>
      <a name="facing" val="west"/>
    </comp>

    <!-- ===================== FIOS ===================== -->

    <!-- INSTR_CLASS[5:0] -> ADDR_COMBINER grupo 1 (830,370) -->
    <wire from="(300,200)" to="(780,200)"/>
    <wire from="(780,200)" to="(780,370)"/>
    <wire from="(780,370)" to="(830,370)"/>

    <!-- STATE: REG_ESTADO.Q(660,400) -> ADDR_COMBINER grupo 0 (830,360) -->
    <wire from="(660,400)" to="(660,360)"/>
    <wire from="(660,360)" to="(830,360)"/>

    <!-- ADDR_COMBINER tronco -> uROM addr -->
    <wire from="(850,350)" to="(960,350)"/>

    <!-- uROM data -> MW_SPLITTER tronco -->
    <wire from="(1030,350)" to="(1220,350)"/>

    <!-- CLK -> REG_ESTADO.CK(600,440) -->
    <wire from="(300,440)" to="(600,440)"/>

    <!-- RESET -> REG_ESTADO.CLR(630,460) -->
    <wire from="(300,480)" to="(450,480)"/>
    <wire from="(450,480)" to="(450,460)"/>
    <wire from="(450,460)" to="(630,460)"/>

    <!-- MW_SPLITTER saidas -> pinos de controle -->
    <wire from="(1200,360)" to="(1400,360)"/>
    <wire from="(1200,370)" to="(1400,370)"/>
    <wire from="(1200,380)" to="(1400,380)"/>
    <wire from="(1200,390)" to="(1400,390)"/>
    <wire from="(1200,400)" to="(1400,400)"/>
    <wire from="(1200,410)" to="(1400,410)"/>
    <wire from="(1200,420)" to="(1400,420)"/>
    <wire from="(1200,430)" to="(1400,430)"/>
    <wire from="(1200,440)" to="(1400,440)"/>
    <wire from="(1200,450)" to="(1400,450)"/>
    <wire from="(1200,460)" to="(1400,460)"/>
    <wire from="(1200,470)" to="(1400,470)"/>
    <wire from="(1200,480)" to="(1400,480)"/>
    <wire from="(1200,490)" to="(1400,490)"/>
    <wire from="(1200,500)" to="(1400,500)"/>

    <!--
    NEXT_STATE realimentacao: MW_SPLITTER grupo0(1200,360) -> REG_ESTADO.D(600,400)
    T-juncao em (1200,360) com pino NEXT_STATE (ambos 3b).
    Rota: sobe y=340, vai ate x=600, desce ate D=(600,400).
    Cruzamento interior em (780,340): INSTR_CLASS(6b) x feedback(3b).
    -->
    <wire from="(1200,360)" to="(1200,340)"/>
    <wire from="(1200,340)" to="(600,340)"/>
    <wire from="(600,340)" to="(600,400)"/>

    <!--
    ESTADO_OUT: REG_ESTADO.Q(660,400) -> pino ESTADO_OUT(1400,540)
    T-juncao em (660,400) com fio STATE (ambos 3b).
    -->
    <wire from="(660,400)" to="(660,540)"/>
    <wire from="(660,540)" to="(1400,540)"/>

  </circuit>
</project>
